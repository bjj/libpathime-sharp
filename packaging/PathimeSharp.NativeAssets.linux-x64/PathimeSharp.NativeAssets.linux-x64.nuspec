<?xml version="1.0" encoding="utf-8"?>
<!--
Packs the staged native payload from artifacts/nuget/linux-x64/ (run
scripts/stage-native.sh first). Publish only CI-built binaries (the
release workflow packs from the CI-staged trees).

Pack with:
  nuget pack packaging/PathimeSharp.NativeAssets.linux-x64/PathimeSharp.NativeAssets.linux-x64.nuspec -OutputDirectory artifacts

The staged tree is flat and soname-named on purpose: every library carries
RUNPATH $ORIGIN and names its siblings by soname, so the standard
runtimes/linux-x64/native flow resolves the whole closure with no subtree.
glib, sqlite3 and libuuid are NOT shipped — they come from the distro
(apt install libglib2.0-0 libsqlite3-0 libuuid1).
-->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PathimeSharp.NativeAssets.linux-x64</id>
    <version>0.1.0</version>
    <authors>Ben Jackson</authors>
    <description>Native libpathime binaries and dictionary data (linux-x64) for PathimeSharp: libpathime.so, its vendored backend libraries (libhangul, anthy-unicode, pyzy), and the pathime-data dictionaries. Reference alongside the PathimeSharp package. Requires the distro's glib, sqlite3 and libuuid (e.g. apt install libglib2.0-0 libsqlite3-0 libuuid1); built against Ubuntu 22.04's glibc. Contains LGPL-2.1 components and GPL-derived data files; see THIRD-PARTY.md.</description>
    <license type="file">THIRD-PARTY.md</license>
    <projectUrl>https://github.com/bjj/libpathime-sharp</projectUrl>
    <tags>ime input-method cjk native pathime</tags>
  </metadata>
  <files>
    <file src="..\..\artifacts\nuget\linux-x64\native\*.so*" target="runtimes\linux-x64\native\" />
    <!-- data/ is a non-convention folder: NuGet treats nothing here as an
         asset; the buildTransitive targets copy the tree to the output. -->
    <file src="..\..\artifacts\nuget\linux-x64\data\pathime-data\**" target="data\pathime-data\" />
    <file src="..\..\artifacts\nuget\linux-x64\licenses\**" target="licenses\" />
    <file src="buildTransitive\PathimeSharp.NativeAssets.linux-x64.targets" target="buildTransitive\" />
    <file src="THIRD-PARTY.md" target="" />
  </files>
</package>
